<div class="shout action" data-timestamp="{{ timestamp }}">
    {%- if avatarsEnabled -%}
        {% include "avatar.html.twig" with { avatar: user.avatar } %}
    {%- endif -%}
    ***{%- include 'user-link.html.twig' with { user } only %}
    {{ shout.shout|slice(4)|theWorksInline }}
    {%- if canDelete -%}
        {%- include 'shoutbox/shout-delete.html.twig' with { shout } only -%}
    {%- endif -%}
</div>
